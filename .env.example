# Preferred: Apps Script Web App URL (read + write, shared across volunteers)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Fallback only (read-only CSV export) — leave unset once Apps Script is configured.
# Defaults to the "Grupuri"/"Catei" tabs of the current sheet if not set.
VITE_GRUPURI_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=Grupuri
VITE_CATEI_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=Catei
